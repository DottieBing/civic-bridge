# Supabase (Settings → API Keys in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-only. Never expose this in browser code or commit the real value.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public address of the site (used for links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications for new messages (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Civic Bridge Africa <onboarding@resend.dev>"
# Optional fallback recipient if no contact email is saved in the admin Settings
CONTACT_NOTIFY_EMAIL=

# Optional: ping an automation tool (n8n, Make, Zapier) on new activity
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=